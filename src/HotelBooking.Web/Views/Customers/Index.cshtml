@model IEnumerable<HotelBooking.Web.Models.Customer>

@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<section class="management-page">
    <header class="page-heading">
        <div>
            <p class="page-eyebrow">DANH MỤC</p>
            <h1>Quản lý khách hàng</h1>
            <p class="page-description">Danh sách thông tin khách hàng của khách sạn.</p>
        </div>
        <a asp-controller="Customers" asp-action="Create" class="btn btn-primary action-button">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M16 20v-1.5a4.5 4.5 0 0 0-4.5-4.5h-3A4.5 4.5 0 0 0 4 18.5V20M10 10a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm9-2v6m3-3h-6" /></svg>
            Thêm khách hàng
        </a>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <div class="data-card">
        <div class="data-card-heading">
            <div>
                <h2>Danh sách khách hàng</h2>
                <p>Thông tin liên hệ đã được lưu trong hệ thống.</p>
            </div>
            <span class="record-count">@Model.Count() khách hàng</span>
        </div>
        <div class="table-responsive">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th scope="col">Họ và tên</th>
                        <th scope="col">Số điện thoại</th>
                        <th scope="col">Email</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td class="cell-primary">@customer.FullName</td>
                            <td class="cell-nowrap">@customer.PhoneNumber</td>
                            <td>@(string.IsNullOrWhiteSpace(customer.Email) ? "Chưa cập nhật" : customer.Email)</td>
                            <td>
                                <div class="row-actions">
                                    <a asp-controller="Customers" asp-action="Edit" asp-route-id="@customer.Id" class="row-action-button edit-button" aria-label="Sửa khách hàng @customer.FullName">Sửa</a>
                                    <form asp-controller="Customers" asp-action="Delete" asp-route-id="@customer.Id" method="post" class="inline-form" onsubmit="return confirm('Bạn có chắc muốn xóa khách hàng này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="row-action-button delete-button" aria-label="Xóa khách hàng @customer.FullName">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="empty-state">Chưa có khách hàng nào. Hãy thêm khách hàng mới.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
