@model IEnumerable<HotelBooking.Web.Models.Customer>

@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                Quản lý khách hàng
            </h2>
            <p class="text-muted mb-0">
                Danh sách thông tin khách hàng của khách sạn
            </p>
        </div>

        <a asp-controller="Customers"
           asp-action="Create"
           class="btn btn-primary rounded-pill px-4">
            + Thêm khách hàng
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>STT</th>
                            <th>Họ và tên</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int stt = 1;
                        }

                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td>@stt</td>

                                <td class="fw-semibold">
                                    @customer.FullName
                                </td>

                                <td>@customer.PhoneNumber</td>

                                <td>
                                    @(string.IsNullOrEmpty(customer.Email)
                                        ? "Chưa cập nhật"
                                        : customer.Email)
                                </td>

                                <td class="text-center">
                                    <a asp-controller="Customers"
                                       asp-action="Edit"
                                       asp-route-id="@customer.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Sửa
                                    </a>

                                    <form asp-controller="Customers"
                                          asp-action="Delete"
                                          asp-route-id="@customer.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa khách hàng này?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>

                            stt++;
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-5">
                                    Chưa có khách hàng nào.
                                    Hãy thêm khách hàng mới!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>