@model IEnumerable<HotelBooking.Web.Models.Booking>

@{
    ViewData["Title"] = "Quản lý đặt phòng";
}

<section class="management-page bookings-page">
    <header class="page-heading">
        <div>
            <p class="page-eyebrow">DANH MỤC</p>
            <h1>Quản lý đặt phòng</h1>
            <p class="page-description">Theo dõi lịch nhận và trả phòng của khách hàng.</p>
        </div>
        <a asp-controller="Bookings" asp-action="Create" class="btn btn-primary action-button">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2" /><path d="M8 3v4m8-4v4M4 10h16m-11 5h6" /></svg>
            Đặt phòng mới
        </a>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <div class="data-card">
        <div class="data-card-heading">
            <div>
                <h2>Danh sách đặt phòng</h2>
                <p>Các lượt đặt phòng đã được ghi nhận.</p>
            </div>
            <span class="record-count">@Model.Count() lượt đặt</span>
        </div>
        <div class="table-responsive">
            <table class="table data-table booking-table">
                <thead>
                    <tr>
                        <th scope="col">Mã đặt phòng</th>
                        <th scope="col">Khách hàng</th>
                        <th scope="col">Số phòng</th>
                        <th scope="col">Ngày nhận</th>
                        <th scope="col">Ngày trả</th>
                        <th scope="col">Tổng tiền</th>
                        <th scope="col">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td class="cell-primary cell-nowrap booking-id">#@booking.Id</td>
                            <td class="booking-customer">@booking.Customer.FullName</td>
                            <td class="cell-nowrap">@booking.Room.RoomNumber</td>
                            <td class="cell-nowrap">@booking.CheckIn.ToString("dd/MM/yyyy")</td>
                            <td class="cell-nowrap">@booking.CheckOut.ToString("dd/MM/yyyy")</td>
                            <td class="cell-price cell-nowrap booking-total">@booking.TotalPrice.ToString("N0") VNĐ</td>
                            <td>
                                @if (booking.Status == "Booked")
                                {
                                    <span class="status-badge status-booked">Đã đặt</span>
                                }
                                else if (booking.Status == "Cancelled")
                                {
                                    <span class="status-badge status-cancelled">Đã hủy</span>
                                }
                                else if (booking.Status == "CheckedOut")
                                {
                                    <span class="status-badge status-neutral">Đã trả phòng</span>
                                }
                                else
                                {
                                    <span class="status-badge status-neutral">@booking.Status</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="empty-state">Chưa có lượt đặt phòng nào. Hãy tạo đặt phòng mới.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
