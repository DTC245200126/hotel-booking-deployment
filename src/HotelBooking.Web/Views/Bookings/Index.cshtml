@model IEnumerable<HotelBooking.Web.Models.Booking>

@{
    ViewData["Title"] = "Quản lý đặt phòng";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                Quản lý đặt phòng khách sạn
            </h2>
            <p class="text-muted mb-0">
                Danh sách các lượt đặt phòng của khách hàng
            </p>
        </div>

        <a asp-controller="Bookings"
           asp-action="Create"
           class="btn btn-primary rounded-pill px-4">
            + Đặt phòng mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">
            <div class="table-responsive">

                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã đặt phòng</th>
                            <th>Khách hàng</th>
                            <th>Số phòng</th>
                            <th>Ngày nhận</th>
                            <th>Ngày trả</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                <td class="fw-bold">
                                    #@booking.Id
                                </td>

                                <td>
                                    @booking.Customer.FullName
                                </td>

                                <td>
                                    @booking.Room.RoomNumber
                                </td>

                                <td>
                                    @booking.CheckIn.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @booking.CheckOut.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-danger fw-semibold">
                                    @booking.TotalPrice.ToString("N0") VNĐ
                                </td>

                                <td>
                                    @if (booking.Status == "Booked")
                                    {
                                        <span class="badge bg-primary">
                                            Đã đặt
                                        </span>
                                    }
                                    else if (booking.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            Đã hủy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @booking.Status
                                        </span>
                                    }
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-5">
                                    Chưa có lượt đặt phòng nào.
                                    Hãy tạo đặt phòng mới!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>