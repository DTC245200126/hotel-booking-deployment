@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<section class="management-page error-page">
    <p class="page-eyebrow">HỆ THỐNG ĐẶT PHÒNG KHÁCH SẠN</p>
    <h1>Có lỗi xảy ra khi xử lý yêu cầu.</h1>
    <p>Vui lòng thử lại sau. Nếu sự cố tiếp tục, hãy liên hệ người quản trị hệ thống.</p>

@if (Model.ShowRequestId)
{
    <p><strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code></p>
}
</section>
